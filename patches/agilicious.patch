+
+namespace agi {
+
+RotorSimpleAugmentationParameters::RotorSimpleAugmentationParameters()
+  : scale_force_(1.0), scale_torque_(1.0) {
+    fx_.setZero();
+    fy_.setZero();
+    fz_.setZero();
+    tx_.setZero();
+    ty_.setZero();
+    tz_.setZero();
+  }
+
+
+bool RotorSimpleAugmentationParameters::load(const Yaml& node) {
+  if (node.isNull()) return false;
+
+  scale_force_ = node["scale_force"].as<Scalar>();
+  scale_torque_ = node["scale_torque"].as<Scalar>();
+  node["fx"]["vx"].getIfDefined(fx_(0));
+  node["fx"]["m_mean"].getIfDefined(fx_(1));
+  node["fx"]["ang_y"].getIfDefined(fx_(2));
+  node["fx"]["vx*m_mean"].getIfDefined(fx_(3));
+  node["fx"]["vx_sqr"].getIfDefined(fx_(4));
+  node["fx"]["vx_cub"].getIfDefined(fx_(5));
+  node["fy"]["vy"].getIfDefined(fy_(0));
+  node["fy"]["m_mean"].getIfDefined(fy_(1));
+  node["fy"]["ang_x"].getIfDefined(fy_(2));
+  node["fy"]["vy*m_mean"].getIfDefined(fy_(3));
+  node["fy"]["vy_sqr"].getIfDefined(fy_(4));
+  node["fy"]["vy_cub"].getIfDefined(fy_(5));
+  node["fz"]["offset"].getIfDefined(fz_(0));
+  node["fz"]["vhor"].getIfDefined(fz_(1));
+  node["fz"]["vz"].getIfDefined(fz_(2));
+  node["fz"]["m_mean"].getIfDefined(fz_(3));
+  node["fz"]["vhor*vz"].getIfDefined(fz_(4));
+  node["fz"]["vhor*m_mean"].getIfDefined(fz_(5));
+  node["fz"]["vz*m_mean"].getIfDefined(fz_(6));
+  node["fz"]["vhor_sqr"].getIfDefined(fz_(7));
+  node["fz"]["vhor*vz*m_mean"].getIfDefined(fz_(8));
+  node["fz"]["vz_cub"].getIfDefined(fz_(9));
+  node["tx"]["vy"].getIfDefined(tx_(0));
+  node["tx"]["m_mean"].getIfDefined(tx_(1));
+  node["tx"]["vy*m_mean"].getIfDefined(tx_(2));
+  node["ty"]["vx"].getIfDefined(ty_(0));
+  node["ty"]["m_mean"].getIfDefined(ty_(1));
+  node["ty"]["vx*m_mean"].getIfDefined(ty_(2));
+  node["tz"]["vx"].getIfDefined(tz_(0));
+  node["tz"]["vy"].getIfDefined(tz_(1));
+  return valid();
+}
+
+bool RotorSimpleAugmentationParameters::valid() const {
+  bool check = true;
+  check &= (scale_force_ >= 0.0);
+  check &= (scale_torque_ >= 0.0);
+  return check;
+}
+
+std::ostream& operator<<(std::ostream& os,
+                         const RotorSimpleAugmentationParameters& p) {
+  os.precision(3);
+  os << std::scientific;
+  os << "RotorSimpleAugmentationParameters:\n"
+     << "Scale Force:           " << p.scale_force_ << "\n"
+     << "Scale Torque:          " << p.scale_torque_ << std::endl;
+  os.precision();
+  os.unsetf(std::ios::scientific);
+  return os;
+}
+
+}  // namespace agi
