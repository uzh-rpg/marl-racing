+#include "agilib/simulator/model_scale.hpp"
+
+#include "agilib/math/gravity.hpp"
+
+
+namespace agi {
+
+
+bool ModelScale::run(const Ref<const Vector<QS::SIZE>> state,
+                     Ref<Vector<QS::SIZE>> derivative) const {
+  if (!state.segment<QS::DYN>(0).allFinite()) return false;
+
+  const Matrix<3, 3> R = Quaternion(state(QS::ATTW), state(QS::ATTX),
+                                    state(QS::ATTY), state(QS::ATTZ))
+                           .toRotationMatrix();
+
+  Vector<3> force =
+    R.transpose() * (derivative.segment<QS::NVEL>(QS::VEL) - GVEC) * quad_.m_;
+  force.segment<2>(0) *= quad_.scale_drag_;
+  force(2) *= quad_.scale_thrust_;
+  derivative.segment<QS::NVEL>(QS::VEL) = R * force / quad_.m_ + GVEC;
+  derivative.segment<QS::NOME>(QS::OME) *= quad_.scale_torque_;
+
+  return true;
+}
+
+
