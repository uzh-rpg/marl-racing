+#include "agilib/simulator/model_external_wrench.hpp"
+
+
+namespace agi {
+
+bool ModelExternalWrench::run(const Ref<const Vector<QS::SIZE>> state,
+                              Ref<Vector<QS::SIZE>> derivative) const {
+  if (!state.segment<QS::DYN>(0).allFinite()) return false;
+
+  // Tiny optimization: only calculate R if needed
+  if (!force_in_bf_ && torque_in_bf_) {
+    derivative.segment<QS::NVEL>(QS::VEL) += wrench_.head<3>() / quad_.m_;
+    derivative.segment<QS::NOME>(QS::OME) += quad_.J_inv_ * wrench_.tail<3>();
+    return true;
+  }
+
+  const Matrix<3, 3> R = Quaternion(state(QS::ATTW), state(QS::ATTX),
+                                    state(QS::ATTY), state(QS::ATTZ))
+                           .toRotationMatrix();
+  if (force_in_bf_)
+    derivative.segment<QS::NVEL>(QS::VEL) += R * wrench_.head<3>() / quad_.m_;
+  else
+    derivative.segment<QS::NVEL>(QS::VEL) += wrench_.head<3>() / quad_.m_;
+
+  if (torque_in_bf_)
+    derivative.segment<QS::NOME>(QS::OME) += quad_.J_inv_ * wrench_.tail<3>();
+  else
+    derivative.segment<QS::NOME>(QS::OME) +=
+      R.transpose() * quad_.J_inv_ * wrench_.tail<3>();
+
+  return true;
+}
+
+bool ModelExternalWrench::setExternalWrench(const Ref<const Vector<6>>& wrench,
+                                            bool force_in_bf,
+                                            bool torque_in_bf) {
+  if (wrench.allFinite()) {
+    wrench_ = wrench;
+    force_in_bf_ = force_in_bf;
+    torque_in_bf_ = torque_in_bf;
+    return true;
+  } else {
+    return false;
+  }
+}
+
+bool ModelExternalWrench::setExternalForce(const Ref<const Vector<3>>& force,
+                                           bool force_in_bf) {
+  if (force.allFinite()) {
+    wrench_.head<3>() = force;
+    force_in_bf_ = force_in_bf;
+    return true;
+  } else {
+    return false;
+  }
+}
+
+bool ModelExternalWrench::setExternalTorque(const Ref<const Vector<3>>& torque,
+                                            bool torque_in_bf) {
+  if (torque.allFinite()) {
+    wrench_.tail<3>() = torque;
