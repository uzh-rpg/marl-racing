+#include "agilib/simulator/model_battery.hpp"
+
+#include <iostream>
+
+#include "agilib/math/types.hpp"
+
+namespace agi {
+
+ModelBattery::ModelBattery(Quadrotor quad, const BatteryParameters& params)
+  : ModelBase(quad), params_(params) {}
+
+
+bool ModelBattery::run(const Ref<const Vector<QS::SIZE>> state,
+                       Ref<Vector<QS::SIZE>> derivative) const {
+  // consumed energy in kJ and instataneous power consumption in W
+  const Scalar E = -state(QS::E) / 1e3 / params_.cell_series_ /
+                   params_.cell_parallel_ / params_.cell_capacity_;
+  const Scalar P = -derivative(QS::E) / params_.cell_series_ /
+                   params_.cell_parallel_ / params_.cell_capacity_;
+
+  const Scalar internal_resistance = params_.r_min_;
+
+  const Scalar U_battery = params_.energy_coefficients_lin_ * E +
+                           params_.energy_coefficients_square_ * E * E +
+                           params_.energy_coefficients_cube_ * E * E * E;
+  const Scalar U_capacity = state(QS::UCAP);
+
+  // voltage_ = U_battery - U_capacity - U_resistor;
+  // This term is not available in real life, since we don't know the
+  // current without knowing the voltage. Can be solved for, see below
+  const Scalar tmp = U_battery - U_capacity;
+  Scalar voltage =
+    params_.u_0_ + 0.5 * (tmp - params_.u_0_ +
+                          sqrt(-4 * internal_resistance * P +
+                               (tmp + params_.u_0_) * (tmp + params_.u_0_)));
+  voltage *= params_.cell_series_;
+
+  // Set up the derivative for the long time constant
+  derivative(QS::UCAP) =
+    (params_.power_coefficient_ * P - U_capacity) / params_.time_constant_;
+
+  // Simulate the battery voltage as a first-order system with 5ms time constant
+  // this is just a way to be able to include it in the state
+  derivative(QS::UBAT) = (voltage - state(QS::UBAT)) / params_.tc_short_;
+
+  return true;
+}
+
+
