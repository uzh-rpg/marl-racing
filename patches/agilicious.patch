+#include "agilib/simulator/model_base.hpp"
+
+namespace agi {
+
+class ModelExternalWrench : public ModelBase {
+ public:
+  EIGEN_MAKE_ALIGNED_OPERATOR_NEW
+
+  ModelExternalWrench(Quadrotor quad) : ModelBase(quad) {}
+  bool run(const Ref<const Vector<QS::SIZE>>,
+           Ref<Vector<QS::SIZE>>) const override;
+
+  bool setExternalWrench(const Ref<const Vector<6>>& wrench,
+                         bool force_in_bf = false, bool torque_in_bf = true);
+  bool setExternalForce(const Ref<const Vector<3>>& force,
+                        bool force_in_bf = false);
+  bool setExternalTorque(const Ref<const Vector<3>>& torque,
+                         bool torque_in_bf = true);
+
+ private:
+  bool force_in_bf_ = true;
+  bool torque_in_bf_ = true;
