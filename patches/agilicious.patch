+#include "agilib/simulator/model_rotor_simple_augmentation.hpp"
+
+namespace agi {
+
+ModelRotorSimpleAugmentation::ModelRotorSimpleAugmentation(
+  Quadrotor quad, const RotorSimpleAugmentationParameters& params)
+  : ModelBase(quad), params_(params) {}
+
+bool ModelRotorSimpleAugmentation::run(const Ref<const Vector<QS::SIZE>> state,
+                                       Ref<Vector<QS::SIZE>> derivative) const {
+  const Matrix<3, 3> R = Quaternion(state(QS::ATTW), state(QS::ATTX),
+                                    state(QS::ATTY), state(QS::ATTZ))
+                           .toRotationMatrix();
+
+  const Vector<3> velocity_body =
+    R.transpose() * (state.segment<QS::NVEL>(QS::VEL) - windspeed_);
+  const Scalar vx = velocity_body(0);
+  const Scalar vy = velocity_body(1);
+  const Scalar vz = velocity_body(2);
+  const Scalar vhor = std::sqrt(vx * vx + vy * vy);
+  const Scalar m_mean =
+    state.segment<QS::NMOT>(QS::MOT).array().square().mean();
+  static const Scalar ang_x = 0;
+  static const Scalar ang_y = 0;
+
+  const Vector<6> poly_fx{
+    vx, m_mean, ang_y, vx * m_mean, vx * std::abs(vx), vx * vx * vx};
+  const Vector<6> poly_fy{
+    vy, m_mean, ang_x, vy * m_mean, vy * std::abs(vy), vy * vy * vy};
+  const Vector<10> poly_fz{1,           vhor,        vz,
+                           m_mean,      vhor * vz,   vhor * m_mean,
+                           vz * m_mean, vhor * vhor, vhor * vz * m_mean,
+                           vz * vz * vz};
+  const Vector<3> poly_tx{vy, m_mean, vy * m_mean};
+  const Vector<3> poly_ty{vx, m_mean, vx * m_mean};
+  const Vector<2> poly_tz{vx, vy};
+
+  const Scalar delta_fx = poly_fx.dot(params_.fx_);
+  const Scalar delta_fy = poly_fy.dot(params_.fy_);
+  const Scalar delta_fz = poly_fz.dot(params_.fz_);
+  const Scalar delta_tx = poly_tx.dot(params_.tx_);
+  const Scalar delta_ty = poly_ty.dot(params_.ty_);
+  const Scalar delta_tz = poly_tz.dot(params_.tz_);
+
+
+  const Vector<3> residual_acceleration =
+    params_.scale_force_ * Vector<3>(delta_fx, delta_fy, delta_fz);
+  const Vector<3> residual_angular_acc =
+    params_.scale_torque_ * Vector<3>(delta_tx, delta_ty, delta_tz);
+
+  // Set up the derivative
+  derivative.segment<QS::NVEL>(QS::VEL) += R * residual_acceleration;
+  derivative.segment<QS::NOME>(QS::OME) += residual_angular_acc;
+
+  return true;
+}
+
+
+}  // namespace agi
