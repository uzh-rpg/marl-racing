+bool BatteryParameters::valid() const {
+  bool check = true;
+  check &= cell_series_ > 0;
+  check &= cell_parallel_ > 0;
+  check &= cell_capacity_ > 0;
+  check &= u_0_ > 0;
+  check &= time_constant_ > 0;
+  check &= tc_short_ > 0;
+  check &= power_coefficient_ > 0;
+  check &= energy_coefficients_lin_ > 0;
+  check &= energy_coefficients_square_ > 0;
+  check &= energy_coefficients_cube_ > 0;
+  return check;
+}
