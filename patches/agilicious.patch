+#pragma once
+
+#include "agilib/math/types.hpp"
+#include "agilib/utils/yaml.hpp"
+
+namespace agi {
+
+template<int channels>
+class FIRFilter {
+  // Implements a general digital filter with numerator coefficients a and
+  // denominator coefficients b. The filter coefficients are give in matlab
+  // order, i.e. Y(z) = (b(1) + b(2)z^-1 + ...)/(1 + a(2)*z^-1 + ...)
+  // or
+  // a(1)y(n)=b(1)x(n)+b(2)x(n−1)+...+b(n_b +1)x(n−n_b)
+  //   −a(2)y(n−1)−...−a(n a +1)y(n−n a).
+  // In the implementation all coefficients are normalized w.r.t a(1)
+
+ public:
+  bool load(const Yaml& node) {
+    const int na = node["na"].as<int>();
+    a_.resize(na, channels);
+    node["a"].getIfDefined(a_);
+
+    const int nb = node["nb"].as<int>();
+    b_.resize(nb, channels);
+    node["b"].getIfDefined(b_);
+
+    na_ = a_.rows();
+    nb_ = b_.rows();
+
+    x_.conservativeResize(nb_, channels);
+    y_.conservativeResize(na_, channels);
+
+    b_.rowwise() /= a_.row(0);
+    a_.rowwise() /= a_.row(0);
+    a_.row(0).setZero();
+
+    x_.setZero();
+    y_.setZero();
+    return true;
+  }
+
+  ArrayVector<channels> add(const ArrayVector<channels>& sample) {
+    // y(n)=b(1)x(n)+b(2)x(n−1)+...+b(n_b +1)x(n−n_b)
+    // −a(2)y(n−1)−...−a(n a +1)y(n−n a).
+    idx_y_ = ((idx_y_ - 1) % na_ + na_) % na_;
+    idx_x_ = ((idx_x_ - 1) % nb_ + nb_) % nb_;
+
+    x_.row(idx_x_) = sample;
+    ArrayVector<channels> numerator =
+      (x_.bottomRows(nb_ - idx_x_) * b_.topRows(nb_ - idx_x_)).colwise().sum();
+    if (idx_x_ > 0) {
+      numerator += (x_.topRows(idx_x_) * b_.bottomRows(idx_x_)).colwise().sum();
+    }
+
+    ArrayVector<channels> denominator =
+      (y_.bottomRows(na_ - idx_y_) * a_.topRows(na_ - idx_y_)).colwise().sum();
+    if (idx_y_ > 0) {
+      denominator +=
+        (y_.topRows(idx_y_) * a_.bottomRows(idx_y_)).colwise().sum();
+    }
+    y_.row(idx_y_) = numerator - denominator;
+    return y_.row(idx_y_);
+  }
+
+
+  ArrayVector<channels> operator()() const { return y_.col(idx_y_); }
+  Scalar operator()(const int i) const { return y_(idx_y_, i); }
+
+  bool valid() const {
+    return b_.allFinite() && a_.allFinite() && x_.allFinite() && y_.allFinite();
+  };
+
+  int init_samples() const { return std::max(na_, nb_); }
+
+ private:
+  Array<Dynamic, channels> b_;
+  Array<Dynamic, channels> a_;
+
+  Array<Dynamic, channels> x_;
+  Array<Dynamic, channels> y_;
+
+  int idx_y_ = 0;
+  int idx_x_ = 0;
+
+  int na_ = 0;
+  int nb_ = 0;
+};
+
+
+}  // namespace agi
